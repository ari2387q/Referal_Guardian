# Referral Guardian Environment Configuration

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///./referral_guardian.db

# LLM Configuration
# Option 1: OpenRouter (Recommended for Multi-Model Access)
